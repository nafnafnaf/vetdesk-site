---
import { ui, homePath, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const base = homePath(lang);
const slides = t.carousel.slides;
const N = slides.length;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{t.hero.eyebrow}</span>
      <h1>{t.hero.title}</h1>
      <p class="lead">{t.hero.subtitle}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`${base}#contact`}>{t.cta.demo}</a>
        <button class="btn btn-ghost" type="button" data-open-video>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M7 4.500v15l13-7.500L7 4.500z" /></svg>
          {t.cta.watch}
        </button>
      </div>
      <p class="muted small">{t.hero.note}</p>
    </div>

    <div class="device">
      <div class="device-bar" aria-hidden="true"><i></i><i></i><i></i></div>

      <div
        class="hero-carousel"
        role="region"
        aria-roledescription="carousel"
        aria-label={t.carousel.label}
        data-carousel
        data-pause-label={t.carousel.pause}
        data-play-label={t.carousel.play}
      >
        <div class="car-viewport">
          <div class="car-track" data-car-track>
            {slides.map((slideTitle, i) => (
              <div
                class="car-slide"
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} ${t.carousel.slideOf} ${N}`}
                aria-hidden={i === 0 ? 'false' : 'true'}
                inert={i !== 0}
                data-slide
              >
                <div class="slide-mock">
                  <div class="mock-label">{slideTitle}</div>

                  {i === 0 && (
                    <img src="/screenshots/slide-01-reschedule.png" alt={slides[0]} class="slide-img" />
                  )}

                  {i === 1 && (
                    <img src="/screenshots/slide-02-reschedule-confirm.png" alt={slides[1]} class="slide-img" />
                  )}

                  {i === 2 && (
                    <img src="/screenshots/slide-03-dashboard.png" alt={slides[2]} class="slide-img" />
                  )}

                  {i === 3 && (
                    <div class="mock-content">
                      <div class="mock-rem-row urgent"><span class="bell">🔔</span><div><b>Max · Εμβολιασμός λύσσας</b><small>Εκπρόθεσμο</small></div></div>
                      <div class="mock-rem-row"><span class="bell">🔔</span><div><b>Luna · Επανεξέταση δέρματος</b><small>Αύριο</small></div></div>
                      <div class="mock-rem-row"><span class="bell">🔔</span><div><b>Bella · Αντιπαρασιτικό</b><small>28/10/2026</small></div></div>
                      <div class="mock-rem-row"><span class="bell">🔔</span><div><b>Rocky · Εμβολιασμός</b><small>15/11/2026</small></div></div>
                      <div class="mock-sms-chip">SMS · 3 αποστολές σήμερα</div>
                    </div>
                  )}

                  {i === 4 && (
                    <div class="mock-content">
                      <div class="mock-bill-row head">
                        <span>Ιδιοκτήτης</span><span>Ποσό</span><span>Κατάσταση</span>
                      </div>
                      <div class="mock-bill-row"><span>Γεωργίου Ν.</span><span>€85</span><span class="paid">Εξοφλήθη</span></div>
                      <div class="mock-bill-row owed-row"><span>Παπάς Κ.</span><span>€120</span><span class="owed">Εκκρεμεί</span></div>
                      <div class="mock-bill-row"><span>Νικολάου Α.</span><span>€45</span><span class="paid">Εξοφλήθη</span></div>
                      <div class="mock-bill-row owed-row"><span>Αντωνίου Μ.</span><span>€210</span><span class="owed">Εκκρεμεί</span></div>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="car-controls">
          <button class="car-btn" aria-label={t.carousel.prev} data-car-prev>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"/>
            </svg>
          </button>
          <div class="car-dots" role="tablist" aria-label={t.carousel.label}>
            {slides.map((title, i) => (
              <button
                class="car-dot"
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={`${i + 1} ${t.carousel.slideOf} ${N}`}
                data-car-dot={i}
              ></button>
            ))}
          </div>
          <button class="car-btn" aria-label={t.carousel.next} data-car-next>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </button>
          <button class="car-btn car-pause" aria-label={t.carousel.pause} aria-pressed="false" data-car-pause>
            <svg class="icon-pause" viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16" rx="1"/><rect x="14" y="4" width="4" height="16" rx="1"/></svg>
            <svg class="icon-play" viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M5 3l14 9-14 9V3z"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <dialog id="video-dialog" class="video-dialog" aria-label={t.cta.watch}>
    <form method="dialog"><button class="close" aria-label={t.hero.close}>&times;</button></form>
    <video id="overview-video" controls playsinline preload="none" poster="/images/poster.svg" src="/videos/overview.mp4"></video>
  </dialog>
</section>

<script>
  // Video dialog
  const dlg = document.getElementById('video-dialog') as HTMLDialogElement | null;
  const overview = document.getElementById('overview-video') as HTMLVideoElement | null;
  document.querySelectorAll('[data-open-video]').forEach((b) =>
    b.addEventListener('click', () => { dlg?.showModal(); overview?.play().catch(() => {}); })
  );
  dlg?.addEventListener('close', () => overview?.pause());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

  // Carousel
  const car = document.querySelector('[data-carousel]') as HTMLElement | null;
  if (car) {
    const track = car.querySelector('[data-car-track]') as HTMLElement;
    const slideEls = [...car.querySelectorAll('[data-slide]')] as HTMLElement[];
    const dots = [...car.querySelectorAll('[data-car-dot]')] as HTMLButtonElement[];
    const prevBtn = car.querySelector('[data-car-prev]') as HTMLButtonElement;
    const nextBtn = car.querySelector('[data-car-next]') as HTMLButtonElement;
    const pauseBtn = car.querySelector('[data-car-pause]') as HTMLButtonElement;
    const iconPause = pauseBtn.querySelector('.icon-pause') as SVGElement;
    const iconPlay = pauseBtn.querySelector('.icon-play') as SVGElement;
    const pauseLabel = car.dataset.pauseLabel ?? 'Pause';
    const playLabel = car.dataset.playLabel ?? 'Play';
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = slideEls.length;
    let idx = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    let manualPause = false;

    function go(n: number) {
      idx = ((n % N) + N) % N;
      if (!rm) track.style.transform = `translateX(-${idx * 100}%)`;
      slideEls.forEach((s, i) => {
        const active = i === idx;
        s.setAttribute('aria-hidden', active ? 'false' : 'true');
        (s as HTMLElement & { inert: boolean }).inert = !active;
        if (rm) s.style.display = active ? '' : 'none';
      });
      dots.forEach((d, i) => d.setAttribute('aria-selected', (i === idx).toString()));
    }

    function startTimer() {
      if (rm || manualPause) return;
      clearInterval(timer);
      timer = setInterval(() => go(idx + 1), 6000);
    }
    function stopTimer() { clearInterval(timer); }

    prevBtn.addEventListener('click', () => { go(idx - 1); startTimer(); });
    nextBtn.addEventListener('click', () => { go(idx + 1); startTimer(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { go(i); startTimer(); }));

    pauseBtn.addEventListener('click', () => {
      manualPause = !manualPause;
      pauseBtn.setAttribute('aria-pressed', manualPause.toString());
      pauseBtn.setAttribute('aria-label', manualPause ? playLabel : pauseLabel);
      iconPause.style.display = manualPause ? 'none' : '';
      iconPlay.style.display = manualPause ? '' : 'none';
      manualPause ? stopTimer() : startTimer();
    });

    car.addEventListener('mouseenter', stopTimer);
    car.addEventListener('mouseleave', () => { if (!manualPause) startTimer(); });
    car.addEventListener('focusin', stopTimer);
    car.addEventListener('focusout', (e) => {
      if (!car.contains(e.relatedTarget as Node)) { if (!manualPause) startTimer(); }
    });
    document.addEventListener('visibilitychange', () =>
      document.hidden ? stopTimer() : (manualPause ? undefined : startTimer())
    );

    go(0);
    if (!rm) startTimer();
  }
</script>

<style>
  /* Carousel shell */
  .hero-carousel { display: flex; flex-direction: column; }
  .car-viewport { overflow: hidden; aspect-ratio: 16 / 10; }
  .car-track {
    display: flex; height: 100%;
    transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .car-track { transition: none; }
  }
  .car-slide { flex: 0 0 100%; height: 100%; overflow: hidden; }

  /* Controls bar */
  .car-controls {
    display: flex; align-items: center; gap: 8px;
    padding: 7px 12px;
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
  }
  .car-btn {
    width: 26px; height: 26px; border-radius: 50%;
    border: 1px solid var(--border); background: var(--surface); color: var(--text);
    cursor: pointer; display: grid; place-items: center; flex-shrink: 0;
  }
  .car-btn:hover { background: var(--bg); }
  .car-btn:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .car-pause { margin-left: auto; }
  .car-pause .icon-play { display: none; }
  @media (prefers-reduced-motion: reduce) { .car-pause { display: none; } }

  .car-dots { display: flex; gap: 6px; flex: 1; justify-content: center; }
  .car-dot {
    width: 7px; height: 7px; border-radius: 50%; border: none; cursor: pointer; padding: 0;
    background: var(--border); transition: background 0.2s, transform 0.2s;
  }
  .car-dot[aria-selected="true"] { background: var(--primary); transform: scale(1.4); }
  .car-dot:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }

  .slide-img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Slide mock — shared */
  .slide-mock {
    width: 100%; height: 100%;
    background: var(--bg-alt);
    display: flex; flex-direction: column;
    font-size: 0.75rem;
  }
  .mock-label {
    padding: 5px 10px;
    font-weight: 700; font-size: 0.65rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--primary-strong);
    background: color-mix(in srgb, var(--primary) 10%, transparent);
    border-bottom: 1px solid var(--border);
    text-align: center;
  }
  .mock-content {
    flex: 1; overflow: hidden;
    padding: 8px 10px;
    display: flex; flex-direction: column; gap: 5px;
  }

  /* Dashboard */
  .mock-metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }
  .mock-metric {
    background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
    padding: 5px 3px; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 1px;
  }
  .mock-metric b { font-size: 1rem; font-weight: 800; color: var(--primary-strong); line-height: 1; }
  .mock-metric small { font-size: 0.6rem; color: var(--muted); }
  .mock-list { display: flex; flex-direction: column; gap: 4px; }
  .mock-appt {
    display: flex; align-items: center; gap: 6px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 7px;
    padding: 5px 8px;
  }
  .mock-appt span:last-child { display: flex; flex-direction: column; font-size: 0.72rem; font-weight: 500; }
  .mock-appt small { font-size: 0.6rem; color: var(--muted); font-weight: 400; }
  .dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
  .dot-done { background: #16a34a; }
  .dot-inroom { background: #15803d; }
  .dot-waiting { background: #d97706; }
  .dot-urgent { background: #dc2626; }

  /* Calendar */
  .mock-cal-head { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; margin-bottom: 3px; }
  .mock-cal-head span { text-align: center; font-weight: 600; font-size: 0.6rem; color: var(--muted); padding: 2px 0; }
  .mock-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
  .cal-day {
    aspect-ratio: 1; display: grid; place-items: center; border-radius: 4px;
    font-size: 0.62rem; color: var(--muted); position: relative;
  }
  .cal-day.has-appt { color: var(--text); font-weight: 600; }
  .cal-day.has-appt::after {
    content: ''; position: absolute; bottom: 2px; left: 50%; transform: translateX(-50%);
    width: 3px; height: 3px; border-radius: 50%; background: var(--primary);
  }
  .cal-day.today {
    background: var(--primary); color: var(--on-primary) !important;
    font-weight: 700; border-radius: 50%;
  }
  .cal-day.today::after { display: none; }

  /* Patient */
  .mock-pat-header {
    display: flex; align-items: center; gap: 8px;
    padding-bottom: 6px; border-bottom: 1px solid var(--border);
  }
  .mock-avatar {
    font-size: 1.4rem; width: 34px; height: 34px;
    display: grid; place-items: center;
    background: var(--surface); border: 1px solid var(--border); border-radius: 50%;
    flex-shrink: 0;
  }
  .mock-pat-header > div { display: flex; flex-direction: column; gap: 1px; }
  .mock-pat-header b { font-size: 0.82rem; }
  .mock-pat-header small { font-size: 0.6rem; color: var(--muted); }
  .mock-pat-rows { display: flex; flex-direction: column; gap: 4px; }
  .mock-pat-row {
    display: flex; align-items: center; gap: 6px; font-size: 0.7rem;
    padding: 4px 7px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px;
  }
  .mock-tag {
    padding: 2px 6px; border-radius: 4px;
    font-size: 0.58rem; font-weight: 600; white-space: nowrap;
    background: color-mix(in srgb, var(--primary) 14%, transparent);
    color: var(--primary-strong);
  }
  .mock-tag.neg { background: color-mix(in srgb, #16a34a 14%, transparent); color: #15803d; }
  .mock-tag.wt { background: color-mix(in srgb, #f08a3c 14%, transparent); color: #c05621; }
  .mock-tag.mic { background: color-mix(in srgb, #6366f1 14%, transparent); color: #4338ca; }

  /* Reminders */
  .mock-rem-row {
    display: flex; align-items: center; gap: 7px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 7px;
    padding: 5px 8px;
  }
  .mock-rem-row.urgent {
    border-color: #f59e0b;
    background: color-mix(in srgb, #f59e0b 10%, transparent);
  }
  .mock-rem-row .bell { font-size: 0.9rem; flex-shrink: 0; }
  .mock-rem-row > div { display: flex; flex-direction: column; gap: 1px; }
  .mock-rem-row b { font-size: 0.7rem; }
  .mock-rem-row small { font-size: 0.6rem; color: var(--muted); }
  .mock-sms-chip {
    margin-top: 2px; align-self: center;
    background: color-mix(in srgb, var(--primary) 14%, transparent);
    color: var(--primary-strong);
    padding: 3px 12px; border-radius: 999px;
    font-size: 0.62rem; font-weight: 600;
  }

  /* Billing */
  .mock-bill-row {
    display: grid; grid-template-columns: 1.6fr 0.8fr 1fr; gap: 4px;
    font-size: 0.68rem; padding: 5px 7px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 6px;
    align-items: center;
  }
  .mock-bill-row.head {
    background: var(--bg); font-weight: 700; font-size: 0.6rem;
    color: var(--muted); letter-spacing: 0.04em;
  }
  .mock-bill-row.owed-row { border-color: color-mix(in srgb, #d97706 40%, transparent); }
  .paid { color: #16a34a; font-weight: 700; }
  .owed { color: #d97706; font-weight: 700; }
</style>
