---
import { site } from '../config';
---
<ul class="socials" style="list-style:none;padding:0;margin:0;">
  {
    site.socials.map((s) => (
      <li>
        <a href={s.href} target="_blank" rel="noopener noreferrer me" aria-label={s.label} title={s.label}>
          {s.id === 'facebook' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v7h4v-7h3l1-4h-4V8z" /></svg>
          )}
          {s.id === 'instagram' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.2" cy="6.8" r="0.8" />
            </svg>
          )}
          {s.id === 'linkedin' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="9" width="4" height="12" />
              <circle cx="5" cy="5" r="2" />
              <path d="M10 9h4v2c1-1.600 2.500-2.300 4.200-2.300C20.700 8.700 21 10.700 21 13v8h-4v-7c0-1.300-.5-2-1.600-2-1.200 0-1.900.8-1.900 2.100V21h-4V9z" />
            </svg>
          )}
          {s.id === 'youtube' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2.500" y="5.500" width="19" height="13" rx="4" />
              <path d="M10 9.500v5l4.500-2.500L10 9.500z" />
            </svg>
          )}
        </a>
      </li>
    ))
  }
</ul>
<style>
  .socials { display: flex; gap: 10px; flex-wrap: wrap; }
</style>
