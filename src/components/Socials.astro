---
import { site } from '../config';
---
<ul class="socials" style="list-style:none;padding:0;margin:0;">
  {
    site.socials.map((s) => (
      <li>
        <a href={s.href} target="_blank" rel="noopener noreferrer me" aria-label={s.label} title={s.label}>
          {s.id === 'facebook' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v7h4v-7h3l1-4h-4V8z" /></svg>
          )}
          {s.id === 'instagram' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.2" cy="6.8" r="0.8" />
            </svg>
          )}
          {s.id === 'viber' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C7.200 2 3 5.400 3 9.800c0 2.600 1.300 5 3.500 6.500V19l2.900-1.600c.800.200 1.700.300 2.600.300 4.800 0 9-3.400 9-7.900C21 5.400 16.800 2 12 2zm.900 10.700c-.300.300-.600.500-1 .500-.100 0-.200 0-.400-.100-1.200-.500-2.200-1.400-2.800-2.500-.200-.400-.300-.800-.100-1.200l.400-.700c.200-.300.600-.400.900-.200l1.200 1c.300.200.300.600.100.900l-.200.300c.500.600 1 1.100 1.700 1.400l.300-.200c.300-.200.700-.200.900.100l1 1.200c.200.300.100.700-.200.900l-.800.600z" />
            </svg>
          )}
        </a>
      </li>
    ))
  }
</ul>
<style>
  .socials { display: flex; gap: 10px; flex-wrap: wrap; }
</style>
