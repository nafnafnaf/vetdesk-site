---
import { ui, type Lang } from '../i18n/ui';
import { site } from '../config';
import Socials from './Socials.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].contact;
---
<section id="contact" class="section section-alt">
  <div class="container contact-single">
    <p class="muted" style="margin-bottom:4px;"><strong>{t.alt}</strong></p>
    <h2 style="margin-top:0;">{t.title}</h2>
    <div class="direct">
      <a class="btn btn-ghost btn-sm" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="btn btn-ghost btn-sm" href={site.viber}>Viber</a>
      <a class="btn btn-ghost btn-sm" href="tel:+306938025100">+30 6938 025100</a>
    </div>
    <Socials />
  </div>
</section>
